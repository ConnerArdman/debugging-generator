# Package-manager settings for the debuggen workspace.
#
# Plain INI: one `key=value` per line, `#` comments. pnpm 12.4.2 is the project's
# package manager (root package.json "packageManager"). npm reads this file
# directly; pnpm >= 10 reads npm-compatible keys from here but takes its own
# settings from pnpm-workspace.yaml, where the same intent is expressed
# (`engineStrict`, `autoInstallPeers`, `enablePrePostScripts`). Keep the two
# files in sync: a change here without the matching change there has no effect
# on a pnpm install, and vice versa. npm additionally warns "Unknown project
# config" for the pnpm-specific keys below and ignores them, which is expected
# and harmless.

# Fail - rather than warn - when the running Node.js is outside the root
# engines.node range ">=24.21.0 <25". The runtime is pinned to the Active LTS
# release 24.21.0, .nvmrc/.node-version carry that version and CI installs Node
# from .nvmrc, so an out-of-range interpreter is a setup error to fix, never
# something to work around by relaxing this flag or widening the range. npm
# enforces this key from here (EBADENGINE); pnpm 12.4.2 mirrors it as
# `engineStrict` in pnpm-workspace.yaml but does not currently hard-fail on
# engines.node, which is why the version files above exist as well.
engine-strict=true

# Install peer dependencies automatically. The workspace is built on peer-only
# relationships on purpose - packages/panel-renderer peers react/react-dom,
# @anthropic-ai/sdk peers zod, @prisma/instrumentation peers @opentelemetry/api,
# bippy peers react - so every workspace manifest can declare just its own
# dependency edges instead of re-declaring each peer.
auto-install-peers=true

# Run pre*/post* lifecycle scripts. The build depends on them: the
# apps/chrome-extension `prebuild` copies the browser-agent bundle
# (scripts/copy-agent.mjs), the packages/panel-renderer `prebuild` regenerates
# tokens.css (scripts/build-tokens.mjs), and apps/demo-app runs `prisma
# generate` from both `prebuild` and `pretypecheck`. With them disabled the
# Chrome extension would build without the agent and the demo app could not
# typecheck a clean clone. The declaration the pinned pnpm actually honours is
# `enablePrePostScripts: true` in pnpm-workspace.yaml: pnpm 12.4.2 ignores this
# npm / pnpm <= 9 spelling entirely - `pnpm config get enable-pre-post-scripts`
# answers from the workspace file's camelCase key and reports `undefined`
# without it, and setting this line to `false` leaves every pre* hook running -
# so it is kept as the npm-compatible mirror of that setting and changed only
# together with it.
enable-pre-post-scripts=true

# Deliberately absent, do not add:
# - the dependency build-script allowlist: it lives in pnpm-workspace.yaml
#   (`allowBuilds` / `onlyBuiltDependencies`), which is where pnpm >= 10 reads
#   it; duplicating it here has no effect.
# - shamefully-hoist / node-linker=hoisted: strict isolation is what keeps the
#   per-package import rules in eslint.config.js honest, because an undeclared
#   dependency then fails to resolve at runtime as well as at lint time.
# - strict-peer-dependencies=false: peer conflicts are fixed in the manifests;
#   if a future package genuinely forces it, name that package in a comment.
# - save-exact: every manifest already pins exact versions.
# - registry credentials of any kind (auth entries, per-registry credential
#   lines): every package comes from the public registry, and
#   scripts/check-secrets.mjs fails CI on a committed credential.
