root = true

# EditorConfig — https://editorconfig.org
#
# `root = true` above is the first declaration on purpose: it stops editors
# traversing further up the filesystem, so this file is the only source of
# whitespace settings for the monorepo.
#
# The values below deliberately mirror .prettierrc.json ("endOfLine": "lf",
# "tabWidth": 2, "useTabs": false) so an editor save can never introduce a diff
# that `pnpm format:check` (prettier --check .) then rejects. Line wrapping is
# Prettier's concern alone (printWidth), so no maximum line length is declared
# here — a second, conflicting limit would only confuse editors.

# baseline for every file in the repository
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: two trailing spaces are a hard line break, so trailing whitespace
# must survive a save (README.md, docs/ARCHITECTURE.md, docs/DEMO.md,
# docs/SECURITY.md and the versioned prompt files under
# apps/local-service/prompts/**). Indentation stays at the inherited 2 spaces —
# a different indent_size would misalign nested lists and fenced code blocks.
[*.md]
trim_trailing_whitespace = false

# YAML is indentation-sensitive and forbids tabs, so the width is stated
# explicitly rather than only inherited: pnpm-workspace.yaml,
# docker-compose.yml, .github/workflows/ci.yml.
[*.{yml,yaml}]
indent_size = 2

# JSON and JSONC: package manifests, tsconfig files, the Prettier config and
# the guard-script policy/allowlist files under scripts/.
[*.{json,jsonc}]
indent_size = 2

# SQL: apps/local-service/src/store/schema.sql and the Prisma migration
# apps/demo-app/prisma/migrations/0001_init/migration.sql.
[*.sql]
indent_size = 2

# TOML (apps/demo-app/prisma/migrations/migration_lock.toml) needs no section
# of its own: the [*] baseline above already gives it spaces, 2-wide, LF and a
# final newline.

# pnpm-lock.yaml is generated by pnpm and must never be hand-edited; run
# `pnpm install` instead. The only rule kept here is the final newline pnpm
# itself writes, so an editor that opens the file cannot strip it and churn the
# lockfile. This section is last so nothing overrides it.
[pnpm-lock.yaml]
insert_final_newline = true
