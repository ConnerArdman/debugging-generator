{
  "name": "debuggen",
  "version": "0.1.0",
  "private": true,
  "description": "Custom Debugging Generator - turns a plain-English debugging question into a purpose-built, interactive debugging panel inside Chrome DevTools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ConnerArdman/debugging-generator.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=12.4.2 <13"
  },
  "scripts": {
    "build": "pnpm demo:generate && pnpm -r build",
    "dev": "pnpm --filter @debuggen/local-service dev",
    "typecheck": "pnpm demo:generate && tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --project local-service-integration",
    "test:vscode": "pnpm --filter ./apps/vscode-extension run test:vscode",
    "test:browser": "playwright test --project browser",
    "test:e2e": "playwright test --project e2e",
    "demo:db": "docker compose up -d postgres",
    "demo:generate": "pnpm --filter @debuggen/demo-app run generate",
    "demo:migrate": "pnpm --filter @debuggen/demo-app run migrate",
    "demo:seed": "pnpm --filter @debuggen/demo-app run seed",
    "demo:dev": "pnpm --filter @debuggen/demo-app run dev",
    "demo:instrumented": "node scripts/dev-instrumented.mjs",
    "check:no-hardcoding": "node scripts/check-no-hardcoding.mjs",
    "check:no-residual-instrumentation": "node scripts/check-no-residual-instrumentation.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm test:integration && pnpm check:no-hardcoding && pnpm check:no-residual-instrumentation && pnpm check:secrets"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "happy-dom": "20.14.5",
    "playwright": "1.63.0",
    "prettier": "3.9.8",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
