{
  "name": "@debuggen/shared",
  "version": "0.1.0",
  "description": "Primitive utilities shared by every workspace (ids, result and error types, path handling, logging, time conversion, and Node-only hashing and safe filesystem helpers) plus the single SourceLocation schema definition.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": [
        "./src/index.ts",
        "./dist/index.d.ts"
      ],
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": [
        "./src/node/index.ts",
        "./dist/node/index.d.ts"
      ],
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run --root ../.. --project shared"
  },
  "dependencies": {
    "nanoid": "6.0.1",
    "zod": "4.6.5"
  }
}
