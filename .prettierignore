# Prettier ignore rules for the debuggen monorepo.
#
# `pnpm format:check` (`prettier --check .`) is a blocking quality gate, so this
# file excludes exactly two categories of path and nothing else:
#
#   1. Build, test and tooling artifacts that are never committed. Kept in sync
#      with .gitignore: the two files must not disagree about what is generated.
#   2. Files that ARE committed but whose exact bytes are owned by a generator,
#      where reformatting would break a check, a build or a byte comparison.
#
# Everything else stays format-checked on purpose, in particular: README.md,
# SECURITY.md, docs/**, apps/local-service/prompts/**, .github/workflows/ci.yml,
# docker-compose.yml, pnpm-workspace.yaml, every workspace's src/**, scripts/*.mjs
# and tests/**. Do not add those here.
#
# Prettier 3 resolves `--ignore-path` to [.gitignore, .prettierignore] by default,
# so section 1 overlaps .gitignore deliberately: repeating the patterns keeps the
# rules correct when Prettier is invoked with an explicit
# `--ignore-path .prettierignore`, which drops the .gitignore half.
#
# Patterns use .gitignore syntax and are relative to the repository root.

# ---------------------------------------------------------------------------
# 1. Never-committed artifacts (mirrors .gitignore)
# ---------------------------------------------------------------------------

# dependencies
node_modules/
.pnpm-store/

# build output: tsup/esbuild/Vite bundles, Next.js output, `tsc -b` state,
# packaged VS Code extensions
dist/
out/
build/
.next/
.tsbuild/
*.tsbuildinfo
*.vsix

# test, coverage and report output
coverage/
test-results/
playwright-report/
blob-report/
.playwright/
.vscode-test/

# Blitzy run artifacts (screenshots, recordings)
blitzy/

# ---------------------------------------------------------------------------
# 2. Committed files whose exact bytes belong to a generator
# ---------------------------------------------------------------------------

# Generated by pnpm. Reformatting it would invalidate the integrity of
# `pnpm install --frozen-lockfile`.
pnpm-lock.yaml

# Generated from src/tokens/tokens.ts by
# packages/panel-renderer/scripts/build-tokens.mjs. tokens.test.ts fails when the
# committed CSS drifts from the generator's output, so Prettier must not touch it.
packages/panel-renderer/src/tokens/tokens.css

# Regenerated by `pnpm check:no-hardcoding --update` from the demo app's code
# index. The check compares the committed file against a freshly generated one,
# so its formatting has to stay exactly as the generator emits it.
scripts/no-hardcoding.policy.json

# Prisma client output (`prisma generate`, run by `pnpm demo:generate`).
apps/demo-app/src/generated/

# Written by Next.js on every `next dev` / `next build`.
apps/demo-app/next-env.d.ts

# Migration SQL authored by Prisma Migrate, plus its migration_lock.toml.
# Prettier has no SQL or TOML parser today; the entry keeps that intentional.
apps/demo-app/prisma/migrations/

# Copied verbatim from packages/telemetry/dist/browser-agent.iife.js by
# scripts/copy-agent.mjs. Byte-for-byte identity with the built bundle matters,
# and the copy is a build product rather than authored source.
apps/chrome-extension/public/agent.iife.js

# Curated, redacted telemetry samples used as golden fixtures. Their bytes are
# what the redaction and correlation tests assert against, so they are kept
# stable rather than reformatted.
packages/telemetry/test/fixtures/
