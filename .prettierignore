# Prettier ignore rules for the debuggen monorepo.
#
# `pnpm format:check` (`prettier --check .`) is a blocking quality gate, so this
# file excludes exactly two categories of path and nothing else:
#
#   1. Build, test and tooling artifacts that are never committed. Kept in sync
#      with .gitignore: the two files must not disagree about what is generated.
#   2. Files that ARE committed but that Prettier must not - or cannot - rewrite:
#      either a generator owns their exact bytes, so reformatting would break a
#      check, a build or a byte comparison, or Prettier has no parser for the
#      language at all and a dedicated validator owns their correctness instead.
#      The second case is a gate requirement, not a preference: `prettier --check`
#      exits 2 with "No parser could be inferred" when such a path is passed
#      explicitly, so leaving one out fails any check that names it.
#
# Everything else stays format-checked on purpose, in particular: README.md,
# SECURITY.md, docs/**, apps/local-service/prompts/**, .github/workflows/ci.yml,
# docker-compose.yml, pnpm-workspace.yaml, every workspace's src/**, scripts/*.mjs
# and tests/**. Do not add those here.
#
# Prettier 3 resolves `--ignore-path` to [.gitignore, .prettierignore] by default,
# so section 1 overlaps .gitignore deliberately: repeating the patterns keeps the
# rules correct when Prettier is invoked with an explicit
# `--ignore-path .prettierignore`, which drops the .gitignore half.
#
# Patterns use .gitignore syntax and are relative to the repository root.

# ---------------------------------------------------------------------------
# 1. Never-committed artifacts (mirrors .gitignore)
# ---------------------------------------------------------------------------

# dependencies
node_modules/

# build output: tsup/esbuild/Vite bundles, Next.js output, `tsc -b` state,
# packaged VS Code extensions
dist/
out/
.next/
.tsbuild/
*.tsbuildinfo
*.vsix

# test, coverage and report output
coverage/
test-results/
playwright-report/
.vscode-test/

# Blitzy run artifacts (screenshots, recordings)
blitzy/

# ---------------------------------------------------------------------------
# 2. Committed files Prettier must not - or cannot - rewrite
# ---------------------------------------------------------------------------

# Generated by pnpm. Reformatting it would invalidate the integrity of
# `pnpm install --frozen-lockfile`.
pnpm-lock.yaml

# Generated from src/tokens/tokens.ts by
# packages/panel-renderer/scripts/build-tokens.mjs. tokens.test.ts fails when the
# committed CSS drifts from the generator's output, so Prettier must not touch it.
packages/panel-renderer/src/tokens/tokens.css

# Regenerated by `pnpm check:no-hardcoding --update` from the demo app's code
# index. The check compares the committed file against a freshly generated one,
# so its formatting has to stay exactly as the generator emits it.
scripts/no-hardcoding.policy.json

# Prisma client output (`prisma generate`, run by `pnpm demo:generate`).
apps/demo-app/src/generated/

# Written by Next.js on every `next dev` / `next build`. The fixture app gets one
# too: tests/e2e/helpers/sample-app.ts serves it in place through the launcher,
# and its own .gitignore keeps the file out of git, but not out of `prettier .`.
apps/demo-app/next-env.d.ts
tests/fixtures/sample-next-app/next-env.d.ts

# Migration SQL authored by Prisma Migrate, plus its migration_lock.toml.
# Prettier has no SQL or TOML parser today; the entry keeps that intentional.
apps/demo-app/prisma/migrations/

# The two authored DDL sources, listed for the same reason as the generated
# migrations above: Prettier has no .sql and no .prisma parser, so naming either
# path on a `prettier --check` command line fails the gate with "No parser could
# be inferred" rather than reporting anything about their formatting. Neither is
# generated - both are hand-written sources of truth - so each is named
# individually rather than by directory, and each has a dedicated validator that
# owns its correctness:
#
#   apps/local-service/src/store/schema.sql - executed verbatim by the built-in
#     node:sqlite binding through `DatabaseSync.exec()` when the service's store
#     applies schema version 1 (apps/local-service/src/store/migrations.ts), so
#     SQLite itself is the parser and malformed DDL fails the store's tests. Its
#     byte layout is load-bearing beyond syntax: the file's own header fixes a
#     comment convention (only `--` line comments, no apostrophes, no quoted
#     text) so the CHECK-vocabulary drift tests and the repository guard scripts
#     can extract its string literals unambiguously.
#
#   apps/demo-app/prisma/*.prisma - the demo's Prisma schema, owned by the
#     Prisma CLI, which ships both the formatter (`prisma format`) and the
#     checker (`prisma validate`) for its own schema language. `prisma generate`
#     parses it on every run and fails on a malformed schema, and that run is not
#     optional: it is the demo app's `prebuild` and `pretypecheck` script and the
#     root `pnpm demo:generate` step that both `pnpm build` and `pnpm typecheck`
#     execute first.
apps/local-service/src/store/schema.sql
apps/demo-app/prisma/*.prisma

# Copied verbatim from packages/telemetry/dist/browser-agent.iife.js by
# scripts/copy-agent.mjs. Byte-for-byte identity with the built bundle matters,
# and the copy is a build product rather than authored source.
apps/chrome-extension/public/agent.iife.js

# Curated, redacted telemetry samples used as golden fixtures. Their bytes are
# what the redaction and correlation tests assert against, so they are kept
# stable rather than reformatted.
packages/telemetry/test/fixtures/
