# Copy to `.env` (git-ignored); the process environment wins over it. A dev
# server the local service launches inherits the service's environment, so keep
# DATABASE_URL identical to the root .env.example. The README's "Environment
# variables" section documents every variable in full.

# PostgreSQL URL for the Prisma CLI and the storefront. Required by migrate,
# seed, dev and start; generate, build, typecheck and check:migration need none.
# The value is the local Docker Compose development credential from
# docker-compose.yml, not a secret.
DATABASE_URL=postgresql://debuggen:debuggen@localhost:5432/lumen_supply

# The origin the storefront is served on, which bounds where checkout's carrier
# and payment calls are addressed. Scheme and port must match exactly; change it
# with the port. When its host is localhost, 127.0.0.1 or [::1], the three are
# interchangeable. Left unset, any of those hosts over http on any port is
# accepted.
APP_ORIGIN=http://localhost:3000
