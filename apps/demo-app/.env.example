# Lumen Supply demo app - example environment. Copy this file to `.env`
# (git-ignored); DATABASE_URL is the only variable this workspace reads.
#
# The value is the local Docker Compose development credential: it matches the
# `postgres` service in docker-compose.yml, reaches nothing but that throwaway
# container and is not a secret, so keep it character for character.
DATABASE_URL=postgresql://debuggen:debuggen@localhost:5432/lumen_supply
