{
  "name": "@debuggen/local-service",
  "version": "0.1.0",
  "private": true,
  "description": "Local coordination service for the Custom Debugging Generator: sessions, code indexing, the staged pipeline, telemetry ingestion and correlation, panel generation and instrumentation cleanup",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    }
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -b",
    "test": "vitest run --root ../.. --project local-service",
    "test:integration": "vitest run --root ../.. --project local-service-integration"
  },
  "dependencies": {
    "@debuggen/code-analysis": "workspace:*",
    "@debuggen/instrumentation": "workspace:*",
    "@debuggen/model-provider": "workspace:*",
    "@debuggen/panel-schema": "workspace:*",
    "@debuggen/protocol": "workspace:*",
    "@debuggen/shared": "workspace:*",
    "@debuggen/telemetry": "workspace:*",
    "@hono/node-server": "2.1.1",
    "dotenv": "18.0.1",
    "hono": "4.13.8",
    "pino": "10.3.1",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  }
}
