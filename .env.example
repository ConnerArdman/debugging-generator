# Debug Generator - example environment. Copy it to `.env` (git-ignored) in the
# repository root. Read by the local service (dotenv, from the directory it is
# started in) and by `docker compose` (docker-compose.yml interpolation); the
# process environment wins over it. Dev servers the service launches inherit
# its DATABASE_URL and NEXT_OTEL_VERBOSE, which win over apps/demo-app/.env,
# so keep DATABASE_URL identical in both. Reader, type and default of every
# variable: README.md#environment-variables; what leaves this machine:
# docs/SECURITY.md.

# ---- Model provider ----

# Anthropic API key, required by DEBUGGEN_PROVIDER=anthropic; no default. Keep a
# real key in `.env` only: `pnpm check:secrets` fails on one in a tracked file.
ANTHROPIC_API_KEY=

# Pipeline provider: `deterministic` (default; rules-based, needs no key, sends
# nothing off this machine, used by every automated test) or `anthropic`.
DEBUGGEN_PROVIDER=deterministic

# Model id, required by `anthropic` and never defaulted; unused otherwise.
DEBUGGEN_MODEL=

# ---- Service ----

# Interface the service binds to; default 127.0.0.1. Loopback only: a wildcard
# or routable address is refused at start-up.
DEBUGGEN_HOST=127.0.0.1

# Port for both HTTP and WebSocket; default 43117, and 0 picks a free port.
DEBUGGEN_PORT=43117

# Absolute path of a versioned prompt directory (`~/` is expanded); empty uses
# the `prompts/` shipped beside the service. The VS Code extension sets it.
DEBUGGEN_PROMPTS_DIR=

# ---- Storage ----

# Session database, file backups, code-index cache and editor credential;
# default ~/.debuggen (an absolute path, `~` or `~/...`). Keep it outside every
# checkout. The service creates it with mode 0700 and its files with 0600.
DEBUGGEN_HOME=~/.debuggen

# Log threshold: trace, debug, info (default), warn, error, fatal or silent.
DEBUGGEN_LOG_LEVEL=info

# Days after which sessions, telemetry, panels, analyses and their backups are
# purged; default 30, and 0 purges everything eligible on the next sweep.
DEBUGGEN_RETENTION_DAYS=30

# ---- Demo database ----

# PostgreSQL URL of the bundled demo app; no default. The local Docker Compose
# development credential, not a secret: scripts/check-secrets.allowlist.json
# allowlists this exact literal, so keep it character for character and put
# your own database in `.env`. Export it for `pnpm test:e2e`, which forwards it.
DATABASE_URL=postgresql://debuggen:debuggen@localhost:5432/lumen_supply

# ---- Optional ----

# Read by the Next.js server, not the service. Exactly `1` makes it create its
# internal spans too (off by default); it prints nothing.
# NEXT_OTEL_VERBOSE=1

# ---- Test suites (process environment only) ----
# The runners never load this file: export these in the shell that runs them.
# Full table, including DEBUGGEN_HOME's test default: README.md#test-suites.

# Origin of the demo the e2e suite drives; default http://localhost:3000.
# DEMO_URL=http://localhost:3000

# Origin of the fixture app; default http://localhost:3100, the port its dev
# script uses, distinct from the demo's default. Keep custom ports distinct too:
# the e2e suite refuses a fixture port equal to the demo's or the service's.
# FIXTURE_APP_URL=http://localhost:3100

# e2e fixture app port (1024-65535); wins over FIXTURE_APP_URL's port.
# SAMPLE_APP_PORT=3100

# pnpm the e2e suite runs (native executable or pnpm.cjs); default PATH's pnpm.
# DEBUGGEN_E2E_PNPM=/absolute/path/to/pnpm

# `pnpm test:vscode` harness, apps/vscode-extension/.vscode-test.mjs:
# Editor build: stable (default), insiders, a commit, or an X.Y.Z version that
# satisfies engines.vscode.
# VSCODE_TEST_VERSION=stable
# Absolute path of an installed editor to use instead of downloading one.
# VSCODE_TEST_PATH=/absolute/path/to/code
# Mocha timeout per test and hook in ms; default 600000, 0 disables it.
# DEBUGGEN_VSCODE_TEST_TIMEOUT_MS=600000
# `1` or `true` keeps the run's throwaway directory; default removes it.
# DEBUGGEN_VSCODE_TEST_KEEP_STATE=1
# Node the suites run Node programs with; default the CLI's Node, not Electron.
# DEBUGGEN_TEST_NODE=/absolute/path/to/node

# ---- Local PostgreSQL container (Docker Compose) ----
# Read by `docker compose` from this file or the environment. Change them only
# to run several checkouts side by side, keeping DATABASE_URL's port in step
# with POSTGRES_PORT.
# POSTGRES_PORT=5432
# POSTGRES_CONTAINER_NAME=debuggen-postgres

# ---- Injected by the tool, never set by hand ----
# DEBUGGEN_TOKEN, DEBUGGEN_INGEST_URL and DEBUGGEN_PROJECT_ROOT are set by the
# service's dev-server launcher and `pnpm demo:instrumented` for the processes
# they start. A hand-set token is never valid.
