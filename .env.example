# Debug Generator - example environment.
#
# Copy this file to `.env` (git-ignored) and change only what you need: every
# value below is the default the code already applies, so an empty `.env`
# behaves identically. This file is the documented list of every variable the
# product and its test suites read, together with the ones the tool injects
# into the processes it starts (last section); README.md's configuration
# section links here rather than repeating it, and docs/SECURITY.md explains
# what leaves this machine.
#
# Uncommented keys are read from `.env` by the local coordination service
# (which loads this file through dotenv) and by the demo application's Prisma
# configuration. Commented keys are read from the *process* environment only,
# by a consumer that does not load `.env` - each says which one - so export
# those in your shell instead of uncommenting them here.

# ---- Model provider ----

# Anthropic API key, used only when DEBUGGEN_PROVIDER=anthropic. Leave it empty
# to run fully offline. Never commit a real key - it belongs in `.env`, which is
# git-ignored, and `pnpm check:secrets` fails on any tracked Anthropic key
# prefix found in a committed file.
ANTHROPIC_API_KEY=

# Which provider the six-stage pipeline calls: anthropic | deterministic.
# `deterministic` is rules-based, needs no key, sends nothing off this machine,
# and is what every automated test uses.
DEBUGGEN_PROVIDER=deterministic

# Model id for the `anthropic` provider. It is always read from the environment
# and never hardcoded in source, so set it when the provider is `anthropic`;
# it is ignored by the deterministic provider.
DEBUGGEN_MODEL=

# ---- Service ----

# Interface the local coordination service binds to. Loopback only: the service
# refuses web origins and authenticates every client (editor, DevTools and
# server-agent credentials), so do not move it to a routable address.
DEBUGGEN_HOST=127.0.0.1

# TCP port serving both the HTTP routes and the WebSocket endpoint.
DEBUGGEN_PORT=43117

# Versioned prompt directory the six-stage pipeline loads its prompts from, as
# `prompts/<stage>/vNNN.md`. Three-step precedence: an explicit override passed
# by the host that starts the service wins, then this variable, then the
# `prompts/` directory shipped beside the service module itself. Leave it empty
# unless you are pointing the service at a prompt set of your own: the VS Code
# extension sets it for the service bundled inside its VSIX, where the prompt
# files are copied next to that bundle, so running from a checkout needs nothing
# here. An empty value counts as absent and the shipped directory is used. Must
# be an absolute path (a leading `~/` is accepted and expanded); the service
# rejects a relative one.
DEBUGGEN_PROMPTS_DIR=

# ---- Storage ----
# Where session state is kept, how loudly the service logs while writing it,
# and how long it survives.

# Root directory for the session database, the file backups taken before any
# instrumentation is applied, and the code-index cache. It deliberately sits
# outside every checkout so a debugging session never pollutes the developer's
# git status; the directory is created with mode 0700 and its files with 0600.
DEBUGGEN_HOME=~/.debuggen

# Service log verbosity (pino levels): trace, debug, info, warn, error, fatal
# or silent.
DEBUGGEN_LOG_LEVEL=info

# Retention purge window in days. Sessions, telemetry, panels, analyses and the
# backups belonging to them are deleted once they are older than this; backups
# for unresolved instrumentation conflicts are kept until they are resolved.
DEBUGGEN_RETENTION_DAYS=30

# ---- Demo database ----

# PostgreSQL connection for the bundled "Lumen Supply" demo application, read
# by its Prisma configuration, its migrations and its seed script. This is the
# local Docker Compose development credential and not a secret: it matches the
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB values in docker-compose.yml
# and is the exact literal allowlisted in scripts/check-secrets.allowlist.json,
# so keep it character for character here and point your own database at `.env`
# instead.
DATABASE_URL=postgresql://debuggen:debuggen@localhost:5432/lumen_supply

# ---- Optional ----

# Uncomment to have Next.js log the OpenTelemetry spans it emits, which helps
# when working on the server-side capture path. Noisy; off by default.
# NEXT_OTEL_VERBOSE=1

# ---- Test suites (process environment only) ----
# Read by playwright.config.ts, which does not load `.env`: export these in the
# shell that runs `pnpm test:browser` / `pnpm test:e2e`, or set them in CI.
# Each default below is the one playwright.config.ts applies when the variable
# is unset, so the suites need no configuration on a normal checkout. The same
# file also honours DEBUGGEN_HOST, DEBUGGEN_PORT, DEBUGGEN_PROVIDER,
# DEBUGGEN_HOME (defaulting to <repo>/test-results/debuggen-home rather than
# ~/.debuggen, so a run never writes into your real session home) and
# DATABASE_URL from the process environment, with the same meanings they have
# above.

# Origin of the demo application the end-to-end suite drives. The suite starts
# the demo through the product launcher, so change this only when the demo's
# dev server is on another port.
# DEMO_URL=http://localhost:3000

# Origin of the generic fixture app under tests/fixtures/sample-next-app, which
# the browser suite and the generalization test drive. Its own dev script pins
# port 3100 so it can never collide with the demo.
# FIXTURE_APP_URL=http://localhost:3100

# ---- Local PostgreSQL container (process environment only) ----
# Read by `docker compose` when it interpolates docker-compose.yml. Compose
# does read `.env` from this directory, so uncommenting these does take effect -
# they are listed as comments because the defaults are what DATABASE_URL above
# already points at. Change them only to run several checkouts side by side,
# and keep DATABASE_URL's port in step with POSTGRES_PORT.
# POSTGRES_PORT=5432
# POSTGRES_CONTAINER_NAME=debuggen-postgres

# ---- Injected by the tool, never set by hand ----
# These three are deliberately absent as values above because the tool writes
# them into the environment of the processes it starts. Setting them here has
# no effect on those processes and can only mislead a reader:
#
#   DEBUGGEN_TOKEN        per-launch server-agent credential, minted by the
#                         service's dev-server launcher and passed only to the
#                         instrumented dev-server child process. It is scoped to
#                         one project root and expires when that process exits,
#                         so a value set by hand is never valid.
#   DEBUGGEN_INGEST_URL   telemetry ingest endpoint, set by that same launcher
#                         (and by `scripts/dev-instrumented.mjs --spawn-local`)
#                         for the Node preload running inside the dev server.
#   DEBUGGEN_PROJECT_ROOT absolute path of the launched project, set alongside
#                         the two above so the preload reports ingest under the
#                         root the credential is scoped to.
