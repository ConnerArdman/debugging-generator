# Model provider -----------------------------------------------------------
# Leave ANTHROPIC_API_KEY empty to run with the deterministic (offline) provider.
ANTHROPIC_API_KEY=
DEBUGGEN_PROVIDER=deterministic
DEBUGGEN_MODEL=

# Local coordination service ----------------------------------------------
DEBUGGEN_HOST=127.0.0.1
DEBUGGEN_PORT=43117
DEBUGGEN_HOME=~/.debuggen
DEBUGGEN_LOG_LEVEL=info
DEBUGGEN_RETENTION_DAYS=30

# Demo application database (local development credential, not a secret) ---
DATABASE_URL=postgresql://debuggen:debuggen@localhost:5432/lumen_supply

# Optional: verbose Next.js OpenTelemetry output
NEXT_OTEL_VERBOSE=0
