# Debug Generator - example environment.
#
# Copy this file to `.env` (git-ignored) in the repository root. Two consumers
# load it, and only two: the local coordination service, through dotenv, from
# the directory the service is started in (so start it from the repository
# root), and `docker compose`, which interpolates docker-compose.yml from it.
# The demo application does not read this file - its Prisma configuration and
# Next.js load `apps/demo-app/.env` (copy apps/demo-app/.env.example there) -
# and the test runners read their process environment only. A variable already
# set in the process environment wins over this file.
#
# The values in the Model provider, Service and Storage sections are the
# defaults the service applies when a key is absent or empty, with two
# exceptions: ANTHROPIC_API_KEY and DEBUGGEN_MODEL are empty because they have
# no default, and with DEBUGGEN_PROVIDER=anthropic the service refuses to start
# until both are set. With the default provider, an empty `.env` therefore
# configures the service identically.
#
# DATABASE_URL and NEXT_OTEL_VERBOSE are not service settings, and DATABASE_URL
# has no default anywhere. They are not inert here either: the service loads
# them into its own environment with the rest of this file, a dev server it
# launches (Launch Dev Server, `pnpm demo:instrumented`, the e2e suite)
# inherits that environment, and an inherited value wins over the project's own
# `.env`, because Next.js and the demo's prisma.config.ts never overwrite a
# variable that is already set. Keep DATABASE_URL here identical to the one in
# apps/demo-app/.env, or remove it from your `.env`, when the demo's own file
# should decide.
#
# What this file lists: every variable the service reads; the demo database
# and Next.js values; the Docker Compose variables; every variable the test
# suites read; the framework- and operating-system-provided variables some
# commands read; and the ones the tool injects into the processes it starts.
# README.md's "Environment variables" section tabulates the same set with each
# reader, type and default, and docs/SECURITY.md explains what leaves this
# machine. Uncommented keys are the service's and the demo database's;
# commented keys are optional, and each section says which consumer reads them
# and whether that consumer loads this file.

# ---- Model provider ----

# Anthropic API key, used only when DEBUGGEN_PROVIDER=anthropic. Leave it empty
# to run fully offline. Never commit a real key - it belongs in `.env`, which is
# git-ignored, and `pnpm check:secrets` fails on any tracked Anthropic key
# prefix found in a committed file.
ANTHROPIC_API_KEY=

# Which provider the six-stage pipeline calls: anthropic | deterministic.
# `deterministic` is rules-based, needs no key, sends nothing off this machine,
# and is what every automated test uses.
DEBUGGEN_PROVIDER=deterministic

# Model id for the `anthropic` provider. It is always read from the environment
# and never hardcoded in source, so set it when the provider is `anthropic`;
# it is ignored by the deterministic provider.
DEBUGGEN_MODEL=

# ---- Service ----

# Interface the local coordination service binds to. Loopback only: the service
# refuses web origins and authenticates every client (editor, DevTools and
# server-agent credentials), so do not move it to a routable address.
DEBUGGEN_HOST=127.0.0.1

# TCP port serving both the HTTP routes and the WebSocket endpoint.
DEBUGGEN_PORT=43117

# Versioned prompt directory the six-stage pipeline loads its prompts from, as
# `prompts/<stage>/vNNN.md`. Three-step precedence: an explicit override passed
# by the host that starts the service wins, then this variable, then the
# `prompts/` directory shipped beside the service module itself. Leave it empty
# unless you are pointing the service at a prompt set of your own: the VS Code
# extension sets it for the service bundled inside its VSIX, where the prompt
# files are copied next to that bundle, so running from a checkout needs nothing
# here. An empty value counts as absent and the shipped directory is used. Must
# be an absolute path (a leading `~/` is accepted and expanded); the service
# rejects a relative one.
DEBUGGEN_PROMPTS_DIR=

# ---- Storage ----
# Where session state is kept, how loudly the service logs while writing it,
# and how long it survives.

# Root directory for the session database, the file backups taken before any
# instrumentation is applied, and the code-index cache: an absolute path, `~`,
# or a path starting with `~/` (expanded against your home directory; `~user/`
# is refused). It deliberately sits outside every checkout, so none of
# the tool's own bookkeeping ever appears in the developer's git status. The
# project's files themselves are the exception: named-function timing patches
# edit tracked source in place, so a patched file shows as modified until
# cleanup restores it byte for byte, and a file the developer edited while it
# was instrumented stays modified with that edit, reported as a conflict. The
# directory is created with mode 0700 and its files with 0600.
DEBUGGEN_HOME=~/.debuggen

# Service log verbosity (pino levels): trace, debug, info, warn, error, fatal
# or silent.
DEBUGGEN_LOG_LEVEL=info

# Retention purge window in days. Sessions, telemetry, panels, analyses and the
# backups belonging to them are deleted once they are older than this; backups
# for unresolved instrumentation conflicts are kept until they are resolved.
DEBUGGEN_RETENTION_DAYS=30

# ---- Demo database ----

# PostgreSQL connection for the bundled "Lumen Supply" demo application (a
# `postgresql://` URL, no default). The demo reads it from the process
# environment or its own `apps/demo-app/.env` - its Prisma configuration for
# migrations and the seed script, Next.js for the storefront's queries - and
# never opens this root file itself. The process environment wins, so the
# value that takes effect is the one in apps/demo-app/.env (copied from
# apps/demo-app/.env.example) unless one is already set: exported in your
# shell, or inherited by a dev server the service launched from this file, as
# the header explains. This line is the reference value, and the one to export
# in the shell that runs `pnpm test:e2e`, which forwards an exported
# DATABASE_URL to the service it starts and to the demo's migrate and seed
# runs. It is the local Docker
# Compose development credential and not a
# secret: it matches the POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB values
# in docker-compose.yml and is the exact literal allowlisted in
# scripts/check-secrets.allowlist.json, so keep it character for character here
# and point your own database at a git-ignored `.env` instead.
DATABASE_URL=postgresql://debuggen:debuggen@localhost:5432/lumen_supply

# ---- Optional ----

# Read by the Next.js server process, not by the service, so set it where the
# dev server's environment comes from - `apps/demo-app/.env` (which `next dev`
# loads), the shell that starts it, or this file when the service launches the
# dev server and it inherits the service's environment. Exactly `1` makes Next.js create its
# internal spans as well as its default set and hand them to the registered
# OpenTelemetry tracer provider - the Node preload's, when it is attached. It
# does not print spans or turn on any console logging. The preload keeps
# framework-internal spans only when they carry an error, so the flag mostly
# adds span-creation work; leave it off unless you are working on the
# server-side capture path. Off by default; any other value leaves it off.
# NEXT_OTEL_VERBOSE=1

# ---- Test suites (process environment only) ----
# The test runners do not load `.env`: export these in the shell that runs the
# suite, or set them in CI. Each default below is the one the named file
# applies when the variable is unset or empty, so the suites need no
# configuration on a normal checkout.
#
# playwright.config.ts (`pnpm test:browser`, `pnpm test:e2e`) also honours
# DEBUGGEN_HOST, DEBUGGEN_PORT and DEBUGGEN_PROVIDER from the process
# environment, with the meanings they have above (provider default
# `deterministic`), plus DEBUGGEN_HOME, which defaults to
# <repo>/test-results/debuggen-home rather than ~/.debuggen so a run never
# writes into your real session home, and DATABASE_URL, which it forwards to
# the service it starts when set.

# Origin (http) of the demo application the end-to-end suite drives. The suite
# starts the demo through the product launcher, so change this only when the
# demo's dev server is on another port. Read by playwright.config.ts.
# DEMO_URL=http://localhost:3000

# Origin (http) of the generic fixture app under tests/fixtures/sample-next-app,
# which the browser suite and the generalization test drive. Its own dev script
# pins port 3100 so it can never collide with the demo. Read by
# playwright.config.ts and the browser and e2e fixtures.
# FIXTURE_APP_URL=http://localhost:3100

# Port (integer 1024-65535, different from the demo's and the service's ports)
# the e2e suite serves the fixture app on; wins over FIXTURE_APP_URL's port,
# which is the default. Read by tests/e2e/helpers/sample-app.ts.
# SAMPLE_APP_PORT=3100

# Flag: `1`, `true` or `yes` (any case) skips `pnpm demo:seed` while you iterate
# on an already-seeded database; migrations still run and the specs report the
# skip. Off by default. Read by tests/e2e/helpers/demo-app.ts.
# DEBUGGEN_E2E_SKIP_SEED=1

# Path of the pnpm the e2e suite runs (demo:migrate, demo:seed and the
# clean-clone install, build and typecheck): a native executable, or pnpm's
# `pnpm.cjs`, which is run with the current Node. Default: `pnpm` from PATH.
# Set it where no pnpm shim is on PATH, or on Windows. Read by
# tests/e2e/helpers/repo.ts.
# DEBUGGEN_E2E_PNPM=/absolute/path/to/pnpm

# Exactly `1` skips the clean-clone spec (two fresh clones with install, build
# and typecheck) on a local run; ignored whenever CI is set. Read by
# tests/e2e/clean-clone.spec.ts.
# DEBUGGEN_SKIP_CLEAN_CLONE=1

# The VS Code extension-host suite (`pnpm test:vscode`) reads the next five in
# apps/vscode-extension/.vscode-test.mjs. That harness removes every inherited
# DEBUGGEN_* and ANTHROPIC_* variable from the editor it starts, sets
# DEBUGGEN_PROVIDER=deterministic and a throwaway DEBUGGEN_HOME there, and
# passes on only DEBUGGEN_TEST_NODE of these names.
#
# Editor build to download: `stable` (default), `insiders`, a commit id, or an
# X.Y.Z version that satisfies engines.vscode (^1.125.0).
# VSCODE_TEST_VERSION=stable
#
# Absolute path of an installed VS Code executable to run instead of
# downloading one; wins over VSCODE_TEST_VERSION, and a path that is not an
# existing file fails the run. Unset by default.
# VSCODE_TEST_PATH=/absolute/path/to/code
#
# Mocha timeout per test and hook, in milliseconds: an integer 0 or more, where
# 0 disables timeouts. Default 600000 (10 minutes).
# DEBUGGEN_VSCODE_TEST_TIMEOUT_MS=600000
#
# `1` or `true` keeps the run's throwaway directory (logs under
# user-data/logs/) and prints its path; `0`, `false` or unset removes it, and
# any other value fails the run.
# DEBUGGEN_VSCODE_TEST_KEEP_STATE=1
#
# Absolute path of the Node.js executable (>=24.21.0 <25) the suites start the
# embedded service with - never the editor's Electron. Default: the Node running
# the test CLI. Also read by apps/vscode-extension/test/helpers.ts.
# DEBUGGEN_TEST_NODE=/absolute/path/to/node
#
# Internal, never set by hand: VSCODE_TEST_EXECUTABLE_PATH, the absolute path
# of the editor executable whose CLI the suites drive for
# `--install-extension` (read by apps/vscode-extension/test/helpers.ts).
# .vscode-test.mjs injects it into the editor it starts only when
# VSCODE_TEST_PATH selects an installed editor; otherwise it is unset and the
# suites fall back to the extension host's own process.execPath, which is the
# editor binary.

# ---- Local PostgreSQL container (Docker Compose) ----
# Read by `docker compose` when it interpolates docker-compose.yml, from the
# process environment or from this file: Compose does read `.env` from this
# directory, so uncommenting these does take effect - they are listed as
# comments because the defaults are what DATABASE_URL above already points at.
# Change them only to run several checkouts side by side, and keep
# DATABASE_URL's port in step with POSTGRES_PORT.
# POSTGRES_PORT=5432
# POSTGRES_CONTAINER_NAME=debuggen-postgres

# ---- Provided by the framework or the operating system, never set here ----
# Listed because the commands in this repository read them; Next.js, a CI
# runner, the shell or pnpm sets each one:
#
#   PORT          the port `next dev` / `next start` actually bound. With
#                 APP_ORIGIN unset, the demo's server-rendered pages address
#                 their own reads to http://127.0.0.1:<PORT>. Choose the port
#                 with `next dev -p <port>` (or PORT exported in the shell that
#                 starts it) and keep APP_ORIGIN in step.
#   CI            any non-empty value: playwright.config.ts forbids
#                 `test.only`, retries a failing test once and starts its own
#                 service instead of reusing one; the clean-clone spec always
#                 runs.
#   PATH          where scripts/dev-instrumented.mjs --spawn-local finds pnpm
#                 (else npm), where the VS Code extension finds `node` for the
#                 bundled service when the editor's own Node is older than 24,
#                 and where the suites find pnpm and node unless configured
#                 above.
#   PATHEXT       Windows only: extensions tried when finding pnpm or npm on
#                 PATH (default .COM;.EXE;.BAT;.CMD).
#   ComSpec       Windows only: the command interpreter --spawn-local runs a
#                 `.cmd` or `.bat` launcher such as pnpm.cmd through (default
#                 cmd.exe).
#   npm_execpath  set by pnpm while it runs a script; the browser suite runs
#                 that same pnpm when it names one.

# ---- Injected by the tool, never set by hand ----
# These three are deliberately absent as values above because the tool writes
# them into the environment of the processes it starts. Setting them here has
# no effect on those processes and can only mislead a reader:
#
#   DEBUGGEN_TOKEN        per-launch server-agent credential, minted by the
#                         service's dev-server launcher and passed only to the
#                         instrumented dev-server child process. It is scoped to
#                         one project root and expires when that process exits,
#                         so a value set by hand is never valid.
#   DEBUGGEN_INGEST_URL   telemetry ingest endpoint, set by that same launcher
#                         (and by `scripts/dev-instrumented.mjs --spawn-local`)
#                         for the Node preload running inside the dev server.
#   DEBUGGEN_PROJECT_ROOT absolute path of the launched project, set alongside
#                         the two above so the preload reports ingest under the
#                         root the credential is scoped to.
